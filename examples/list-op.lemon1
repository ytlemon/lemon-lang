// 列表操作：编号槽、命名列表，以及 add / del / file / clear
//
// 要点：
//   - list(1) 是编号槽：全局容器，用到就存在；list(分数) 是命名列表，就是普通变量
//   - list(X) 是个普通表达式，所以能 say / len / 取下标
//   - 列表可变；同一个编号或名字再声明一次是"初始化"（覆盖），不是追加
//   - add / del / file / clear 都是上下文关键字，可作普通变量名
//   - 仍不支持按下标赋值

__init__ {
    def 统计(数字) {
        // 编号槽是全局的：在函数里加，函数外也读得到
        clear list(100)
        cycle(len(数字)) {
            add[数字[i]] to list(100)
        }
        return len(list(100))
    }

    main() {
        // 建一个列表，编号 1，然后一个个加进去
        add list(1)
        add[90] to list(1)
        add[85] to list(1)
        add[78] to list(1)

        file list(1)              // 一行一个
        say(list(1))              // [90, 85, 78] —— 也能当值用
        say(len(list(1)))         // 3
        say(list(1)[1])           // 85

        del[85] to list(1)        // 删元素：列表还在，只是少了一项
        file list(1)              // 90 / 78

        clear list(1)             // 清空内容，但列表还在
        say(len(list(1)))         // 0
        add[5] to list(1)
        say(list(1))              // [5]

        del list(1)               // 删掉整个列表：编号 → 列表 这条绑定没了
        say(len(list(1)))         // 0 —— 再引用是个新的空槽
        add[6] to list(1)         // 照样能重新往里加
        say(list(1))              // [6]

        // 块式初始化编号槽；list(name = 2) 是同一种写法的显式版
        list(name = 2) {
            甲
            乙
        }
        file list(2)

        // 命名列表用同一套操作
        list(名单) {
            小明
        }
        add[小红] to list(名单)
        add[小刚] to list(名单)
        file list(名单)
        say(名单)
        del[小明] to list(名单)
        say(名单)

        // 引用语义：两个名字指向同一个列表，改一个另一个也变
        list(3) { 1 }
        list(别名) { list(3) }
        add[2] to list(3)
        say(别名)                 // [1, 2]

        // 编号槽可以当返回值用
        say(统计(名单))            // 2

        // 上下文关键字不影响既有写法
        int add = 1
        text file = 文本
        say(add)
        say(file)
    }
}
