// try / catch：捕获运行期错误，程序不会因此中断
__init__ {
    int zero = 1 - 1

    def 除法(a, b) {
        say(a / b)
    }

    def 递归() {
        递归()
    }

    main() {
        // 1) 捕获除零，并读取错误值的字段
        try {
            say("开始计算")
            除法(7, zero)
            say("这一行不会执行")
        } catch (错误) {
            say("捕获到了")
            say(错误)
            say(错误.code)
            say(错误.line)
        }

        // 2) 捕获递归过深 —— 兜住忘了写终止条件的递归
        try {
            递归()
        } catch (错误) {
            say(错误.code)
        }

        // 3) 没出错时 catch 不会执行
        try {
            say("一切正常")
        } catch (错误) {
            say("不该看到这一行")
        }

        say("程序继续跑")
    }
}
