// 引入别的 .lemon1 文件：#incloud 把目标源码就地并入本程序
//
//   #incloud lib/工具     // 同目录 / 子目录，不带 .lemon1 会自动补上
//   #incloud "lib/工具.lemon1" // 加引号也行
//
// 规则：写在行首、独占一行；行尾可以跟 // 注释。
// 写在 __init__ 之前时，内容会落到 __init__ { 之后。
#incloud lib/工具

__init__ {
    main() {
        打招呼(小明)
        say(版本)
        重复输出(滴, 3)
    }
}
