// 函数返回值：return
//
// 语法要点：
//   - return 表达式 带值返回；光秃秃的 return 表示提前收工
//   - return 是语句不是表达式，值必须和它写在同一行
//   - 只能写在函数体内；main() 里只允许不带值的 return（提前结束程序）
//   - 函数体里有带值的 return → 调用结果是 any；没有 → 仍是 unit
//   - return 不是错误，try / catch 抓不到它
//   - 写在 cycle 里会结束整个函数，而不只是跳出循环（那是 break 的活儿）

__init__ {
    def 加(a, b) {
        return a + b
    }

    def 绝对值(x) {
        if x < 0 {
            return 0 - x
        }
        return x
    }

    def 阶乘(n) {
        if n <= 1 {
            return 1
        }
        return n * 阶乘(n - 1)
    }

    // return 结束的是整个函数：找到就立刻返回，不再往下循环
    def 首个大于(数字, 阈值) {
        cycle(len(数字)) {
            if 数字[i] > 阈值 {
                return 数字[i]
            }
        }
        return 没有更大的
    }

    // return 不是错误，所以 catch 只会接住真正的运行期错误
    def 安全除(a, b) {
        try {
            return a / b
        } catch (错误) {
            return 错误.code
        }
    }

    // 不带值的 return：提前收工
    def 只说话() {
        say("这句话会输出")
        return
        say("这句话永远不会")
    }

    main() {
        say(加(2, 3))                    // 5
        say(加(1, 1) * 10)               // 20
        say(绝对值(0 - 7))                // 7
        say(绝对值(7))                    // 7
        say(阶乘(5))                      // 120

        list(数字) {
            1
            5
            9
            12
        }
        say(首个大于(数字, 6))             // 9
        say(首个大于(数字, 100))           // 没有更大的

        say(安全除(10, 5))                // 2
        say(安全除(10, 0))                // E0405

        只说话()                          // 只输出第一句
        say(只说话())                     // unit

        // 返回值可以直接当条件
        if 加(1, 1) == 2 {
            say("返回的值能当条件")
        }
    }
}
