// if / elif / else：条件不写括号，分支体用花括号，可以嵌套
__init__ {
    // 函数可以按名字一眼看出意图
    def 评级(分数) {
        if 分数 >= 90 {
            say("优秀")
        } elif 分数 >= 60 {
            say("及格")
        } else {
            say("不及格")
        }
    }

    def 符号(n) {
        if n > 0 {
            if n > 100 {
                say("很大的正数")
            } else {
                say("正数")
            }
        } elif n == 0 {
            say("零")
        } else {
            say("负数")
        }
    }

    // 有了 if，递归终于可以用"终止条件"收敛
    def 倒数(n) {
        say(n)
        if n > 1 {
            倒数(n - 1)
        }
    }

    main() {
        评级(95)
        评级(60)
        评级(59)

        符号(500)
        符号(3)
        符号(0)
        符号(-3)

        倒数(3)

        // 条件不成立且没有 else 时，什么都不做
        if false {
            say("这一行不会出现")
        }
        say("结束")
    }
}
