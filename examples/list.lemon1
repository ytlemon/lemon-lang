// 列表：块式声明、下标读取、长度、嵌套
//
// 语法要点：
//   - list(名字) { ... } 一行一个元素，元素是任意表达式
//   - 它同时是"声明"：作用域规则与 int a = 1 完全相同
//   - list(name = 名字) 与 list(名字) 等价，只是把"这里是列表名"写明白
//   - 没有方括号字面量；[ ] 只用来取下标，下标从 0 开始
//   - 越界是运行期错误（E0415），可以被 try / catch 捕获

__init__ {
    list(name = 分数) {
        90
        85
        78
    }

    // 元素类型可以混合
    list(杂) {
        1
        你好
        true
    }

    // 元素是表达式，按书写顺序求值
    int 附加 = 5
    list(计算过的) {
        附加 + 1
        附加 * 2
    }

    main() {
        say(分数)          // [90, 85, 78]
        say(分数[0])       // 90
        say(分数[2])       // 78
        say(len(分数))     // 3

        say(杂)            // [1, 你好, true]
        say(计算过的)       // [6, 10]

        // 配合 cycle 遍历
        cycle(len(分数)) {
            say(分数[i])
        }

        // 嵌套：元素可以是另一个列表，下标连着写
        list(表格) {
            分数
            计算过的
        }
        say(表格)           // [[90, 85, 78], [6, 10]]
        say(表格[1][0])     // 6

        // 越界可以被捕获
        try {
            say(分数[99])
        } catch (错误) {
            say(错误.code)  // E0415
            say(错误.message)
        }
    }
}
