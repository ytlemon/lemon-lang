// 时间：带单位的字面量 + sleep
// Lemon 里的时间**一律以秒为单位**：sleep(1) 停 1 秒，sleep(1000) 停 1000 秒。
// 带单位的写法统一换算成"多少秒"的 double：1min → 60.0、500ms → 0.5。
__init__ {
    def 限帧跑(轮数, 每轮) {
        cycle(轮数) {
            say(i)
            sleep(每轮)
        }
    }

    main() {
        // 1) 各种单位的换算结果
        say(1min)
        say(500ms)
        say(2s)
        say(1.5h)

        // 2) 换算之后就是普通数字，可以参与运算
        say(1min + 30)
        say(1min / 4)

        // 3) 暂停
        sleep(0.1)      // 100 毫秒
        sleep(500ms)    // 一样是 100 毫秒
        say("暂停结束")

        // 4) 限帧：每轮歇一下，别把 CPU 跑满
        限帧跑(3, 0.05)

        // 5) 精度：受系统定时器粒度影响，约 15 毫秒量级
        sleep(0)
        say("完")
    }
}
