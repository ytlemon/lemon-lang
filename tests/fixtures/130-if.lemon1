// if / elif / else：条件不写括号，分支体用花括号，可以嵌套
__init__ {
    def 评级(分数) {
        if 分数 >= 90 {
            say("优秀")
        } elif 分数 >= 60 {
            say("及格")
        } else {
            say("不及格")
        }
    }

    def 分类(n) {
        if n > 0 {
            if n > 100 {
                say("很大的正数")
            } else {
                say("正数")
            }
        } elif n == 0 {
            say("零")
        } else {
            say("负数")
        }
    }

    main() {
        评级(95)
        评级(60)
        评级(59)

        分类(500)
        分类(3)
        分类(0)
        分类(-3)

        // 条件不成立且没有 else 时什么都不做
        if false {
            say("不会出现")
        }
        say("结束")
    }
}
