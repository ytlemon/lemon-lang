// 时间单位字面量与 sleep：Lemon 里的时间一律以秒为单位
__init__ {
    def 预计总时长() {
        double 单次 = 250ms
        double 轮数 = 4.0
        say(单次 * 轮数)
    }

    main() {
        // 带单位的字面量统一换算成"多少秒"的 double
        say(1min)
        say(500ms)
        say(2s)
        say(1.5h)

        // 换算之后就是普通数字，可以参与运算
        say(1min + 30)

        预计总时长()

        // sleep(0) 立即返回
        sleep(0)
        say("结束")
    }
}
