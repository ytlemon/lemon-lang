// cycle(N)：重复 N 次，体内 i 从 0 递增到 N-1
__init__ {
    def 报数(次数) {
        cycle(次数) {
            say(i)
        }
    }

    main() {
        报数(3)

        // 0 次：一次都不执行
        cycle(0) {
            say("不会出现")
        }

        // 循环体每轮都是新作用域，i 是轮到第几次
        cycle(2) {
            int 局部 = i * 10
            say(局部)
        }

        // 嵌套：内层的 break 只跳出内层
        cycle(2) {
            cycle(5) {
                if i == 1 {
                    break
                }
                say(i)
            }
            say("外层")
        }

        // 轮次变量会遮蔽外层的同名变量
        int i = 99
        cycle(2) {
            say(i)
        }
        say(i)
    }
}
